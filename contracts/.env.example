# Deployment configuration for contracts/script/Deploy.s.sol.
# NEVER commit a filled-in copy of this file. .env is gitignored for a reason.

# Deployer key. Use a throwaway testnet key with no mainnet funds.
PRIVATE_KEY=

# Creditcoin RPC to deploy against.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Source chain (for deploying TradeEventEmitter).
SOURCE_RPC_URL=https://sepolia-proxy-rpc.creditcoin.network

# Creditcoin's key for the source chain. NOT the EVM chain id.
SOURCE_CHAIN_KEY=3

# TradeEventEmitter address on the source chain. REQUIRED: without a trusted emitter no proof
# can bind to a trade, so the deploy script refuses to run.
SOURCE_EMITTER=

# Existing settlement stablecoin. Leave blank to deploy SettlementToken alongside the protocol.
SETTLEMENT_TOKEN=

# Units to mint into the testnet faucet. Zero skips faucet deployment entirely.
FAUCET_SUPPLY=0
