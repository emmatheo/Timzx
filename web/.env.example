# ---------------------------------------------------------------------------
# TImx frontend configuration
#
# Copy to .env.local and fill in after deploying the contracts.
# Every value here is NEXT_PUBLIC_* and ships to the browser. Never put a private key,
# a service-role key, or any secret in this file.
# ---------------------------------------------------------------------------

# Creditcoin network the app targets: cc3-testnet | cc3-devnet
NEXT_PUBLIC_CREDITCOIN_NETWORK=cc3-testnet

# ---------------------------------------------------------------------------
# Protocol contracts (printed by contracts/script/Deploy.s.sol)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TRADE_FINANCE_ADDRESS=
NEXT_PUBLIC_COLLATERAL_VAULT_ADDRESS=
NEXT_PUBLIC_TRADE_ESCROW_ADDRESS=
NEXT_PUBLIC_REPAYMENT_MANAGER_ADDRESS=
NEXT_PUBLIC_USC_ADAPTER_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_FAUCET_ADDRESS=

# TradeEventEmitter, deployed on the SOURCE chain (Sepolia) — not on Creditcoin.
NEXT_PUBLIC_SOURCE_EMITTER_ADDRESS=

# ---------------------------------------------------------------------------
# Attestation
#
# There is one path: fetch an inclusion proof, confirm the source height is attested, submit the
# proof for on-chain verification. An event that cannot be proved does not move a trade.
# ---------------------------------------------------------------------------

# Creditcoin's identifier for the source chain. NOT the EVM chain id, and it differs per
# Creditcoin environment. The Developer page reads the authoritative list from the ChainInfo
# precompile and warns if this value is not in it.
NEXT_PUBLIC_SOURCE_CHAIN_KEY=3

# Proof generation API, e.g. https://proof-gen-api.cc3-devnet.creditcoin.network
NEXT_PUBLIC_PROOF_API_URL=

# Source-chain RPC (Sepolia) and the optional attestation indexer.
NEXT_PUBLIC_SOURCE_RPC_URL=https://sepolia-proxy-rpc.creditcoin.network
NEXT_PUBLIC_ATTESTATIONS_GRAPHQL_URL=

# ---------------------------------------------------------------------------
# QueryBuilder field offsets (required before any proof can be submitted)
#
# Byte offsets into the canonically encoded transaction that the proof covers. Produce them by
# running the @gluwa/usc-sdk QueryBuilder against a real TradeEventEmitter transaction on the
# source chain. Do NOT guess: a wrong offset binds a valid proof to the wrong bytes. If these are
# unset, the app refuses to submit a proof and says why, rather than sending a malformed one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_QUERY_OFFSET_RX_STATUS=
NEXT_PUBLIC_QUERY_OFFSET_LOG_ADDRESS=
NEXT_PUBLIC_QUERY_OFFSET_TOPIC0=
NEXT_PUBLIC_QUERY_OFFSET_TRADE_ID=

# ---------------------------------------------------------------------------
# Supabase
#
# The anon key is read-only by row level security and safe in the browser. Trade metadata,
# documents and messages live here; the chain remains authoritative for every financial value.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets
#
# NOT prefixed with NEXT_PUBLIC, and never imported from a client component. The service role key
# bypasses row level security and the session secret mints login cookies — either one leaking to
# the browser would let anyone write as anyone. On Vercel, add these as encrypted environment
# variables, not in this file.
# ---------------------------------------------------------------------------

# Supabase service role key. Used only by route handlers under web/src/app/api.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key for the wallet session cookie. At least 32 characters; generate with:
#   openssl rand -base64 48
SESSION_SECRET=
